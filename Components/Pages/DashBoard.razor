@page "/"

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard</h2>
            <p class="text-muted mb-0">
                Manage all users from one place.
            </p>
        </div>

        <button class="btn btn-primary px-4">
            <i class="bi bi-person-plus-fill me-2"></i>
            Add User
        </button>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <StatisticsCard
                Title="Total Users"
                Value="24"
                Subtitle="Registered Users"
                IconClass="bi bi-people-fill"
                IconBgClass="bg-primary-subtle" />
        </div>

        <div class="col-xl-3 col-md-6">
            <StatisticsCard
                Title="Average Age"
                Value="26"
                Subtitle="Years"
                IconClass="bi bi-bar-chart-fill"
                IconBgClass="bg-success-subtle" />
        </div>

        <div class="col-xl-3 col-md-6">
            <StatisticsCard
                Title="Youngest User"
                Value="18"
                Subtitle="Years"
                IconClass="bi bi-person-heart"
                IconBgClass="bg-warning-subtle" />
        </div>

        <div class="col-xl-3 col-md-6">
            <StatisticsCard
                Title="Oldest User"
                Value="52"
                Subtitle="Years"
                IconClass="bi bi-person-badge-fill"
                IconBgClass="bg-info-subtle" />
        </div>

    </div>

    <!-- Users -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    Users
                </h5>

                <div style="width:350px;">
                    <SearchBar
                        SearchTerm="@SearchText"
                        SearchTermChanged="OnSearchChanged"
                        Placeholder="Search users..." />
                </div>

            </div>

        </div>

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Email</th>
                        <th>Age</th>
                        <th width="150">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var user in DemoUsers)
                    {
                        <tr>

                            <td class="ps-4">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="rounded-circle bg-primary text-white fw-bold d-flex justify-content-center align-items-center"
                                         style="width:40px;height:40px;">

                                        @user.Initials

                                    </div>

                                    <span>@user.Name</span>

                                </div>

                            </td>

                            <td>@user.Email</td>

                            <td>@user.Age</td>

                            <td>

                                <button class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@code {

    private string SearchText = "";

    private void OnSearchChanged(string value)
    {
        SearchText = value;
    }

    private List<DemoUser> DemoUsers = new()
    {
        new DemoUser
        {
            Name="Muhammad Ziyam Khan",
            Email="ziyam@example.com",
            Age=17,
            Initials="MZ"
        },

        new DemoUser
        {
            Name="Ahmed Ali",
            Email="ahmed@example.com",
            Age=24,
            Initials="AA"
        },

        new DemoUser
        {
            Name="Sara Khan",
            Email="sara@example.com",
            Age=21,
            Initials="SK"
        }
    };

    public class DemoUser
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public int Age { get; set; }
        public string Initials { get; set; } = "";
    }

}