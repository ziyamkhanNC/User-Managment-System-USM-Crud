<header class="navbar navbar-expand bg-white border-bottom border-light-subtle sticky-top px-4 h-16 shadow-xs">
    <div class="container-fluid px-0">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-light d-lg-none" type="button" @onclick="OnToggleSidebar">
                <i class="bi bi-list fs-5"></i>
            </button>
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary" href="/">
                <span class="bg-primary text-white rounded-2 px-2 py-1 fs-6">USM</span>
                <span class="d-none d-sm-inline text-dark">User Management System</span>
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill d-none d-md-inline-block">
                <i class="bi bi-circle-fill fs-8 me-1"></i> REST API Connected
            </span>

            <button class="btn btn-outline-light text-secondary position-relative border-0" type="button">
                <i class="bi bi-bell fs-5"></i>
                <span class="position-absolute top-2 start-75 translate-middle p-1 bg-primary border border-light rounded-circle"></span>
            </button>

            <div class="vr mx-1 d-none d-sm-block"></div>

            <div class="d-flex align-items-center gap-2">
                <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold text-xs" style="width: 32px; height: 32px;">
                    AD
                </div>
                <div class="d-none d-lg-block text-start">
                    <div class="fw-bold text-dark fs-7">Admin User</div>
                    <div class="text-muted fs-8">System Manager</div>
                </div>
            </div>
        </div>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
}
