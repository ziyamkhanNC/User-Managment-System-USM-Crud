@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-header-title text-danger fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        @Title
                    </h5>
                    <button type="button" class="btn-close" @onclick="OnCancel" disabled="@IsLoading"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-secondary mb-0">@Message</p>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-2 px-3" @onclick="OnCancel" disabled="@IsLoading">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger rounded-2 px-3" @onclick="OnConfirm" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span>@ConfirmText</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Delete";
    [Parameter] public string Message { get; set; } = "Are you sure you want to delete this record?";
    [Parameter] public string ConfirmText { get; set; } = "Delete";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
